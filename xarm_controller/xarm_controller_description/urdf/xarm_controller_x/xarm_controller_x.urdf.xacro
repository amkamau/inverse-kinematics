<?xml version="1.0"?>
<robot name="xarm_controller_x" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="port_name" default="/dev/ttyUSB0" />
  <xacro:arg name="ros2_control_type" default="xarm_controller_x_position" />

  <xacro:include filename="$(find xarm_controller_description)/gazebo/xarm_controller_x.gazebo.xacro" />

  <xacro:include filename="$(find xarm_controller_description)/urdf/xarm_controller_x/xarm_controller_x_arm.urdf.xacro" />

  <xacro:include filename="$(find xarm_controller_description)/ros2_control/$(arg ros2_control_type).ros2_control.xacro" />

  <link name="world"/>

  <joint name="$(arg prefix)world_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="$(arg prefix)base1"/>
  </joint>

  <xacro:xarm_controller_x prefix="$(arg prefix)" />
  <xacro:xarm_controller_x_gazebo prefix="$(arg prefix)" />

  <xacro:xarm_controller_x_system
    name="XarmControllerXSystem" prefix="$(arg prefix)" use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    port_name="$(arg port_name)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find open_manipulator_bringup)/config/xarm_controller_x/hardware_controller_manager.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
