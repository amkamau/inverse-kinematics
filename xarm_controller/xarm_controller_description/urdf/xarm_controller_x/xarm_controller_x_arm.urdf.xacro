<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="xarm_controller_x" params="prefix=''">

    <xacro:property
      name="meshes_file_direction"
      value="package://xarm_controller_description/meshes/xarm_controller_x"/>

    <!-- BASE -->
    <link name="${prefix}base1">
      <visual>
        <origin xyz="-0.0725 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/base1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="blue">
          <color rgba="0.2 0.7 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/base1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
      
    <!-- Joint 1 :: base -to- link1 -->
    <joint name="${prefix}joint1" type="revolute">
        <parent link="${prefix}base1"/>
        <child link="${prefix}link1"/>
        <origin xyz="0.0 0.0 0.063" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit velocity="4.8" effort="1000" lower="${-2.7}" upper="${2.7}" />
        <dynamics damping="0.1"/>
    </joint>

    <!-- link1 -->
    <link name="${prefix}link1">
      <visual>
        <origin xyz="-0.007 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="red">
          <color rgba="0.8 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
          <origin xyz="0 0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${meshes_file_direction}/link1.stl" scale="0.001 0.001 0.001"/>
          </geometry>
      </collision>
      <inertial>
          <origin xyz="-3.0184870e-04 5.4043684e-04 ${0.018 + 2.9433464e-02}" />
          <mass value="9.8406837e-02" />
          <inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07" iyy="3.2689329e-05" iyz="2.8511935e-08" izz="1.8850320e-05" />
        </inertial>
    </link>

    <!-- Joint 2 :: link1-to-link2 -->
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0.0025 0.0 0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1000" lower="${-1.5}" upper="${1.5}" />      
      <dynamics damping="0.1"/>
    </joint>
    
    <!-- link2 -->
    <link name="${prefix}link2">
      <visual>
        <origin xyz="-0.0095 0 -0.0138" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${meshes_file_direction}/link2.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="green">
            <color rgba="0.2 0.8 0.2 1"/>
          </material>
      </visual>
      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${meshes_file_direction}/link2.stl" scale="0.001 0.001 0.001"/>
          </geometry>
      </collision>
       <inertial>
        <origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01" />
        <mass value="1.3850917e-01" />
        <inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05" iyy="3.4290447e-04" iyz="-1.5717516e-06" izz="6.0346498e-05" />
      </inertial>
    </link>

    <!-- Joint 3 :: link2-to-link3-->
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="0.0 0 0.101" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1000" lower="${-1.5}" upper="${1.5}" />
      <dynamics damping="0.1"/>
    </joint>

    <!-- link3 -->
    <link name="${prefix}link3">
      <visual>
        <origin xyz="-0.01046 -0.01971 -0.01066" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="red">
          <color rgba="0.2 0.8 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="9.0909590e-02 3.8929816e-04 2.2413279e-04" />
        <mass value="1.3274562e-01" />
        <inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07" iyy="2.4230292e-04" iyz="1.1559550e-08" izz="2.5155057e-04" />
      </inertial>
    </link>

    <!-- Joint 4 link3-to-link4-->
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0.0 0.0 0.095" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1000" lower="${-1.7}" upper="${1.7}" />
      <dynamics damping="0.1"/>
    </joint>

    <!-- link4 -->
    <link name="${prefix}link4">
      <visual>
        <origin xyz="-0.0105 -0.0195 -0.012" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="green">
          <color rgba="0.2 0.8 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="4.4206755e-02 3.6839985e-07 8.9142216e-03" />
        <mass value="1.4327573e-01" />
        <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06" iyy="7.5980465e-05" iyz="0.0" izz="9.3127351e-05" />
      </inertial>
    </link>


    <!-- Joint 5 :: link4-to-link5-->
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="0.0 0.0 0.068" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="1000" lower="${-1.7}" upper="${1.7}"/>
      <dynamics damping="0.1"/>
    </joint>
    
    
    <!-- Link 5: Wrist Spacer -->
    <link name="${prefix}link5">
      <visual>
        <origin xyz="-0.0015 -0.0085 -0.0168" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="red">
          <color rgba="1.0 0.0 0.0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/link5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="4.4206755e-02 3.6839985e-07 8.9142216e-03" />
        <mass value="1.4327573e-01" />
        <inertia ixx="8.0870749e-05" ixy="0.0" ixz="-1.0157896e-06" iyy="7.5980465e-05" iyz="0.0" izz="9.3127351e-05" />
      </inertial>
    </link>

    <!-- Joint 6 Left Gripper -->
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}gripper_left_link"/>
      <origin xyz="-0.0155 -0.013 0.015" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="4.8" effort="1000" lower="0" upper="1.5708"/>
      <dynamics damping="0.1"/>
    </joint>

    <!-- Left Gripper Link -->
    <link name="${prefix}gripper_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/gripper_left.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/gripper_left.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1.0e-06" ixy="0" ixz="0" iyy="1.0e-06" iyz="0" izz="1.0e-06"/>
      </inertial>
    </link>

    <!-- Right Gripper Joint: Mimic of Left Gripper -->
    <joint name="${prefix}joint6_right_joint" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}gripper_right_link"/>
      <origin xyz="-0.0155 0.012 0.015" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="4.8" effort="1000" lower="-1.5708" upper="0"/>
      <dynamics damping="0.1"/>
      <mimic joint="${prefix}joint6" multiplier="-1"/>
    </joint>

    <!-- Right Gripper Link -->
    <link name="${prefix}gripper_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/gripper_right.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/gripper_right.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1.0e-06" ixy="0" ixz="0" iyy="1.0e-06" iyz="0" izz="1.0e-06"/>
      </inertial>
    </link>

    <joint name="${prefix}end_effector_joint" type="fixed">
      <parent link="${prefix}link5"/>
      <child link="${prefix}end_effector_link"/>
      <origin xyz="0.0 0.0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}end_effector_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="red">
          <color rgba="1.0 0.0 0.0 1"/>
        </material>
      </visual>
    </link>


  </xacro:macro>

</robot>
