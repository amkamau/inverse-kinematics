
<?xml version="1.0"?>
<robot name="xarm_test">

  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.7" upper="2.7" effort="10" velocity="1"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1"/>
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.5" effort="10" velocity="1"/>
  </joint>

  <ros2_control name="XArmTestSystem" type="system">
    <hardware>
      <plugin>xarm_controller_hardware/XArmHardware</plugin>
      <param name="mock_hardware">false</param>
    </hardware>

    <joint name="joint1">
      <param name="min_position">-2.7</param>
      <param name="max_position">2.7</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="joint2">
      <param name="min_position">-1.5</param>
      <param name="max_position">1.5</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="joint3">
      <param name="min_position">-1.5</param>
      <param name="max_position">1.5</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="joint4">
      <param name="min_position">-1.5</param>
      <param name="max_position">1.5</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="joint5">
      <param name="min_position">-1.5</param>
      <param name="max_position">1.5</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="joint6">
      <param name="min_position">-1.5</param>
      <param name="max_position">1.5</param>
      <param name="max_velocity">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
