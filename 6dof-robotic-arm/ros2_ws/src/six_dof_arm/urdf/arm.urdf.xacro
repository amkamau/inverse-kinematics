<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dof_arm">

  <!-- Dimensions are illustrative, in metres. -->
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="link1_length" value="0.12"/>
  <xacro:property name="link2_length" value="0.15"/>
  <xacro:property name="link3_length" value="0.12"/>
  <xacro:property name="link_radius" value="0.025"/>

  <!-- Reusable cylindrical link geometry.
       Cylinders are aligned along their local Z axes. -->
  <xacro:macro name="cylinder_link" params="name length radius mass">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3 * radius * radius + length * length) / 12}"
          ixy="0" ixz="0"
          iyy="${mass * (3 * radius * radius + length * length) / 12}"
          iyz="0"
          izz="${mass * radius * radius / 2}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="arm_blue">
          <color rgba="0.2 0.45 0.85 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2}"/>
      <geometry>
        <cylinder radius="0.06" length="${base_height}"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.35 0.35 0.38 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2}"/>
      <geometry>
        <cylinder radius="0.06" length="${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height / 2}"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Shoulder link: rotates about the vertical axis. -->
  <xacro:cylinder_link name="link1" length="${link1_length}"
                       radius="${link_radius}" mass="0.3"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"
           effort="10" velocity="1.0"/>
  </joint>

  <xacro:cylinder_link name="link2" length="${link2_length}"
                       radius="${link_radius}" mass="0.25"/>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708"
           effort="10" velocity="1.0"/>
  </joint>

  <xacro:cylinder_link name="link3" length="${link3_length}"
                       radius="${link_radius}" mass="0.2"/>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0"
           effort="8" velocity="1.0"/>
  </joint>

  <!-- Wrist placeholders -->
  <link name="wrist_link">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="wrist_gray">
        <color rgba="0.7 0.7 0.72 1"/>
      </material>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0"
           effort="5" velocity="1.0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.04 0.04 0.08"/></geometry>
      <material name="tool_gray">
        <color rgba="0.85 0.55 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.04 0.04 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"
           effort="5" velocity="1.0"/>
  </joint>

  <!-- Fixed placeholder for the gripper attachment -->
  <link name="gripper_link">
    <visual>
      <geometry><box size="0.06 0.025 0.025"/></geometry>
      <material name="gripper_gray">
        <color rgba="0.25 0.25 0.27 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.025 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper_mount" type="fixed">
    <parent link="tool_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

</robot>
